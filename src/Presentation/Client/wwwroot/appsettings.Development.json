{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ApplicationSettings": {

    "CultureSettings": {
      "DefaultCulture": "fa-IR",
      "SupportedCultures": [ "fa-IR", "en-US" ]
    },

    "PageSettings": {
      "Rotate": "180",
      "RevealOnScroll": "True"
    }
  }
}