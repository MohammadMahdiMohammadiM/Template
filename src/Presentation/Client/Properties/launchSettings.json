{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Client": {
      "launchBrowser": true,
      "dotnetRunMessages": true,

      "commandName": "Project",
      "applicationUrl": "https://localhost:7292",
